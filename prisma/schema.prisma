generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Recipe {
  id           Int                @id @default(autoincrement())
  externalId   String             @unique
  name         String
  category     String?
  area         String?
  instructions String?
  thumbnailUrl String?
  youtubeUrl   String?
  sourceUrl    String?
  tags         Json?
  llmSummary   String?
  rawPayload   Json
  ingredients  RecipeIngredient[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model RecipeIngredient {
  id             Int      @id @default(autoincrement())
  recipeId       Int
  name           String
  normalizedName String
  measure        String?
  position       Int
  recipe         Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([normalizedName])
  @@unique([recipeId, position])
}

model ImportLog {
  id           Int      @id @default(autoincrement())
  searchTerm   String
  status       String
  recipesFound Int
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([searchTerm])
  @@index([status])
}
